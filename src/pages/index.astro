---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';
import Github from '../components/icons/Github.astro';
import Linkedin from '../components/icons/Linkedin.astro';
import {
  Mail,
  ExternalLink,
  ArrowUpRight,
  Briefcase,
  Layers,
  Code,
} from '@lucide/astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order || 0) - (b.data.order || 0)
);
---

<Layout title={`${profile.name} — ${profile.role}`}>
  <main class="space-y-16">
    <!-- Header / Hero Section -->
    <header class="space-y-6">
      <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-neutral-900 border border-neutral-800 text-neutral-300">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            {profile.status}
          </div>

          <div class="space-y-1">
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
              {profile.name}
            </h1>
            <p class="text-sm font-mono text-neutral-400">
              {profile.fullName} · @{profile.handle}
            </p>
          </div>

          <p class="text-lg text-neutral-400 max-w-xl leading-relaxed">
            {profile.tagline}
          </p>
        </div>

        <img
          src={profile.avatarUrl}
          alt={profile.name}
          class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl border border-neutral-800 object-cover shadow-2xl self-start sm:self-auto"
          loading="eager"
        />
      </div>

      <!-- Quick Action Social Links -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href={profile.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-sm font-medium bg-neutral-900 hover:bg-neutral-800 text-neutral-200 border border-neutral-800 transition-colors"
        >
          <Github class="w-4 h-4 text-neutral-400" />
          GitHub
          <ArrowUpRight class="w-3.5 h-3.5 text-neutral-500" />
        </a>

{profile.socials.linkedin && (
  <a
    href={profile.socials.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-sm font-medium bg-neutral-900 hover:bg-neutral-800 text-neutral-200 border border-neutral-800 transition-colors"
  >
    <Linkedin class="w-4 h-4 text-neutral-400" />
    LinkedIn
    <ArrowUpRight class="w-3.5 h-3.5 text-neutral-500" />
  </a>
)}

        <a
          href={profile.socials.email}
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-sm font-medium bg-neutral-900 hover:bg-neutral-800 text-neutral-200 border border-neutral-800 transition-colors"
        >
          <Mail class="w-4 h-4 text-neutral-400" />
          Email
        </a>
      </div>
    </header>

    <!-- Bento Grid Section: Projects -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold tracking-tight text-white flex items-center gap-2">
          <Code class="w-5 h-5 text-neutral-400" />
          Featured Projects
        </h2>
        <span class="text-xs font-mono text-neutral-500 uppercase tracking-wider">
          {projects.length} Showcases
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {projects.map((project) => (
          <article class="group relative flex flex-col justify-between p-6 rounded-2xl bg-neutral-900/60 hover:bg-neutral-900/90 border border-neutral-800 hover:border-neutral-700 transition-all duration-300 shadow-sm">
            <div class="space-y-3">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-lg font-semibold text-white group-hover:text-blue-400 transition-colors">
                  {project.data.title}
                </h3>
                <div class="flex items-center gap-2">
                  {project.data.repoUrl && (
                    <a
                      href={project.data.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="p-1.5 rounded-lg text-neutral-400 hover:text-white hover:bg-neutral-800 transition-colors"
                      aria-label={`GitHub repo for ${project.data.title}`}
                    >
                      <Github class="w-4 h-4" />
                    </a>
                  )}
                  {project.data.demoUrl && (
                    <a
                      href={project.data.demoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="p-1.5 rounded-lg text-neutral-400 hover:text-white hover:bg-neutral-800 transition-colors"
                      aria-label={`Live demo for ${project.data.title}`}
                    >
                      <ExternalLink class="w-4 h-4" />
                    </a>
                  )}
                </div>
              </div>

              <p class="text-sm text-neutral-400 leading-relaxed">
                {project.data.description}
              </p>
            </div>

            <div class="flex flex-wrap gap-1.5 pt-6 mt-auto">
              {project.data.tags.map((tag) => (
                <span class="px-2.5 py-0.5 rounded-md text-xs font-mono text-neutral-400 bg-neutral-800/80 border border-neutral-700/50">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Technical Skills Matrix -->
    <section class="space-y-6">
      <h2 class="text-xl font-semibold tracking-tight text-white flex items-center gap-2">
        <Layers class="w-5 h-5 text-neutral-400" />
        Technical Competencies
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {profile.skills.map((group) => (
          <div class="p-5 rounded-2xl bg-neutral-900/40 border border-neutral-800 space-y-4">
            <h3 class="text-sm font-mono uppercase tracking-wider text-neutral-400">
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {group.skills.map((skill) => (
                <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-neutral-900 border border-neutral-800 text-neutral-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience Timeline -->
    <section class="space-y-6">
      <h2 class="text-xl font-semibold tracking-tight text-white flex items-center gap-2">
        <Briefcase class="w-5 h-5 text-neutral-400" />
        Experience & Milestones
      </h2>

      <div class="space-y-6 border-l border-neutral-800 pl-6 ml-2">
        {profile.experiences.map((exp) => (
          <div class="relative group">
            <div class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-neutral-800 border-2 border-neutral-950 group-hover:bg-blue-500 transition-colors"></div>
            
            <div class="space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                <h3 class="text-base font-semibold text-white">
                  {exp.role} · <span class="text-neutral-400 font-normal">{exp.company}</span>
                </h3>
                <span class="text-xs font-mono text-neutral-500">
                  {exp.period}
                </span>
              </div>

              <p class="text-sm text-neutral-400 leading-relaxed max-w-2xl">
                {exp.description}
              </p>

              <div class="flex flex-wrap gap-1.5 pt-1">
                {exp.technologies.map((tech) => (
                  <span class="text-[11px] font-mono text-neutral-500">
                    #{tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="pt-12 border-t border-neutral-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-neutral-500">
      <p>© {new Date().getFullYear()} {profile.name}. Zero JS static delivery.</p>
      <div class="flex items-center gap-4">
        <a href={profile.socials.github} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-300 transition-colors">GitHub</a>
{profile.socials.linkedin && (
  <a href={profile.socials.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-300 transition-colors">LinkedIn</a>
)}
        <a href={profile.socials.email} class="hover:text-neutral-300 transition-colors">Contact</a>
      </div>
    </footer>
  </main>
</Layout>
